{
  "name": "kefu-rag-main",
  "version": "1.0.0",
  "description": "Customer service RAG with LlamaIndex + Elasticsearch",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "postbuild": "node scripts/copy-docreader-proto.cjs",
    "docreader:check": "tsx scripts/docreader-probe.ts",
    "test:docreader": "node --import tsx --import ./scripts/test-env.ts --test --test-concurrency=1 src/ingestion/parser/docreader*.test.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "preview:web": "vite preview",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "test": "node --import tsx --import ./scripts/test-env.ts --test --test-concurrency=8 src/**/*.test.ts frontend/src/**/*.test.ts",
    "start": "node dist/index.js",
    "ingest": "tsx src/ingestion/cli.ts",
    "release:verify:local": "node --import tsx scripts/release-verify.ts local ./release-verification-local.json",
    "release:verify:production": "node --import tsx scripts/release-verify.ts production ./release-verification-production.json",
    "release:promotion-check": "node --import tsx scripts/release-promotion-check.ts",
    "release:smoke": "node --import tsx scripts/smoke-cli.ts",
    "demo:rebuild": "node --import tsx scripts/demo-rebuild.ts",
    "demo:seed": "node --import tsx scripts/demo-seed.ts",
    "demo:reset": "node --import tsx scripts/demo-reset.ts",
    "auth:ui-smoke": "node scripts/auth-ui-smoke.cjs",
    "release:quality-gate": "node --import tsx scripts/release-quality-gate.ts",
    "check:dead": "knip"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20.3"
  },
  "type": "commonjs",
  "dependencies": {
    "@assistant-ui/react": "^0.15.17",
    "@elastic/elasticsearch": "^9.4.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "@llamaindex/env": "^0.1.30",
    "@mastra/core": "^1.51.0",
    "@mastra/mcp": "^1.17.1",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@types/better-sqlite3": "^7.6.13",
    "@volcengine/openapi": "1.36.2",
    "better-sqlite3": "^12.11.1",
    "cn": "^0.4.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "glimm": "^0.3.1",
    "jose": "^5.10.0",
    "langfuse": "^3.38.20",
    "lucide-react": "^1.58.0",
    "motion": "^14.6.0",
    "neo4j-driver": "^6.2.0",
    "openai": "^6.46.0",
    "pdf-lib": "1.17.1",
    "pino": "^10.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "knip": "^6.39.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0",
    "vite": "^7.3.6",
    "zod": "^4.4.3"
  }
}
