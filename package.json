{
  "name": "kefu-rag-main",
  "version": "1.0.0",
  "description": "Customer service RAG with LlamaIndex + Elasticsearch",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "dev:web": "vite",
    "build:web": "vite build",
    "preview:web": "vite preview",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "start": "node dist/index.js",
    "ingest": "tsx src/ingestion/cli.ts",
    "release:verify:local": "node --import tsx scripts/release-verify.ts local ./release-verification-local.json",
    "release:verify:production": "node --import tsx scripts/release-verify.ts production ./release-verification-production.json",
    "release:promotion-check": "node --import tsx scripts/release-promotion-check.ts",
    "release:smoke": "node --import tsx scripts/smoke-cli.ts",
    "eval:residue": "node --import tsx scripts/eval-residue.ts",
    "demo:rebuild": "node --import tsx scripts/demo-rebuild.ts",
    "demo:seed": "node --import tsx scripts/demo-seed.ts",
    "demo:reset": "node --import tsx scripts/demo-reset.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20.3"
  },
  "type": "commonjs",
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.59",
    "@assistant-ui/react": "^0.15.17",
    "@elastic/elasticsearch": "^9.4.2",
    "@mastra/core": "^1.51.0",
    "@mastra/mcp": "^1.17.1",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^5.10.0",
    "langfuse": "^3.38.20",
    "llamaindex": "^0.12.1",
    "lucide": "^0.554.0",
    "morphicons": "^1.7.1",
    "neo4j-driver": "^6.2.0",
    "openai": "^6.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0",
    "vite": "^7.3.6",
    "zod": "^4.4.3"
  }
}
