{
  "name": "electron-app",
  "private": true,
  "version": "0.1.0",
  "description": "Electron + React desktop app",
  "main": "./out/main/index.mjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test \"src/main/**/*.test.ts\" \"src/renderer/src/**/*.test.ts\"",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "tlc": "cd formal && java -cp vendor/tla2tools.jar tlc2.TLC -deadlock -cleanup -config RouterLoopBuffering.cfg RouterLoopBuffering.tla",
    "tlc:lifecycle": "cd formal && java -cp vendor/tla2tools.jar tlc2.TLC -deadlock -cleanup -config RouterLifecycle.cfg RouterLifecycle.tla"
  },
  "dependencies": {
    "@animateicons/react": "^0.13.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@streamdown/code": "^2.0.0",
    "@tailwindcss/vite": "^4",
    "@tdesign-react/chat": "^1.1.0",
    "lucide": "^1.70.0",
    "morphicons": "^2.0.2",
    "pi-subagents": "0.87.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-breaks": "^4.0.0",
    "streamdown": "^2.7.1",
    "tailwindcss": "^4",
    "tdesign-react": "^1.18.6",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "electron": "^40.0.0",
    "electron-vite": "^4.0.0",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^7"
  },
  "allowScripts": {
    "electron@40.10.6": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
