# Elasticsearch
ES_NODE=http://localhost:9200
ES_API_KEY=
# Single physical index shared by ingestion, retrieval, cleanup and maintenance.
# Switch only after migration verification; isolated eval scopes keep their own indices.
ES_CHUNK_INDEX=kefu-rag-chunks

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
# Per-request OpenAI-compatible client timeout (ms) and retry count.
# Bounds every LLM call in the Answer + ingestion chains so a hung
# provider cannot occupy a connection for the SDK default 10 minutes.
OPENAI_REQUEST_TIMEOUT_MS=200000
OPENAI_MAX_RETRIES=1

# Question-routing decision provider: chat (default) or clef.
# Clef uses the fixed Cloudflare model @cf/cloudflare/clef. Both credentials
# are required when DECISION_PROVIDER=clef; keep their values in local .env.
DECISION_PROVIDER=chat
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Per-decision ceiling in integer milliseconds (1 through 2147483647).
DECISION_REQUEST_TIMEOUT_MS=10000

# Embeddings (defaults to the OpenAI settings above)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Dedicated rerank (shared by normal chat and evaluation)
# Protocol verified against POST {RERANK_BASE_URL}/rerank
# (request: {model, query, documents}; response: results[].index + relevance_score).
# An empty RERANK_API_KEY disables dedicated rerank: retrieval publishes the
# fused order and reports degradation — there is no Chat-scoring fallback.
RERANK_API_KEY=
RERANK_BASE_URL=https://api.edgefn.net/v1
RERANK_MODEL=bge-reranker-v2-m3
# Per-call ceiling (ms) and per-candidate character cap.
RERANK_TIMEOUT_MS=30000
RERANK_MAX_DOCUMENT_CHARS=4000

# Optional whole-Answer-run resource budgets (unset = unlimited)
# ANSWER_RUN_MAX_MODEL_CALLS=
# ANSWER_RUN_MAX_TOKENS=
# ANSWER_RUN_MAX_COST_MICROS=
# ANSWER_RUN_MODEL_PRICING_JSON=

# Volcengine OCRPdf: the only production OCR provider (images + PDF OCR).
# Enable the intelligent document parsing service on the Volcengine account.
# Server-only AK/SK; these are NOT an Ark/OpenAI Bearer API key.
VOLC_ACCESSKEY=
VOLC_SECRETKEY=
# Optional session token when using STS temporary credentials.
VOLC_SESSION_TOKEN=
# OCR uses PARSER_TIMEOUT_MS (120000), PARSER_INPUT_LIMIT_BYTES (20 MiB)
# and PARSER_OUTPUT_LIMIT_BYTES (20 MiB). PDFs split at 16 pages and encoded
# requests are bounded to 8 MiB. A single oversized page/image fails clearly.

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Langfuse observability (optional; enabled when BOTH keys are set)
# Self-hosted instance base URL, e.g. http://localhost:3000 (docker-compose default)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# LO-05 tracing (OpenTelemetry → Langfuse OTLP). OFF by default and only on
# when TRACING_ENABLED is truthy, the keys above are set, and the sample rate
# is a legal value in [0,1]. An illegal rate turns tracing off (with a warning)
# instead of guessing. `off` == no exporter, no queue, no sampling.
TRACING_ENABLED=0
LANGFUSE_SAMPLE_RATE=1

# LO-03 runtime logs: structured JSON on stdout through Pino.
# debug | info | warn | error | off. `off` disables the logger entirely
# (same code path as an un-injected logger, so it is a safe rollback).
LOG_LEVEL=info

# Ticket 35 (TOOL-01B): the local read-only MCP capability server. Set to 0
# to disable discovery entirely (no child process, no MCP tools in chat).
MCP_CAPABILITIES=1

# Ticket 36 (WEB-01): optional server-side Tavily key for web search. The key
# lives ONLY in server config. Absent → a run that asks for web search gets an
# honest "unconfigured" report; URL reads of links pasted into the message
# keep working without it (through the same safe URL fetcher as ingestion).
TAVILY_API_KEY=

# Ticket 01 (IAM-01): the three-account local OIDC identity demo. Set to 1 to
# force enforced access mode with the local issuer (admin / technical-reader /
# policy-reader); unset runs the single-tenant deterministic identity.
DEMO_OIDC=
