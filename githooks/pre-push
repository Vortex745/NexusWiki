#!/bin/sh
# Retro-guardrails T4: push gate. The repo's guardrail is its test suite;
# a red suite must not leave the machine silently. Same checks a CI would run.
set -e
cd "$(git rev-parse --show-toplevel)"

echo "[pre-push] npm run build"
npm run build

echo "[pre-push] npm run typecheck:web"
npm run typecheck:web

echo "[pre-push] npm test"
npm test
